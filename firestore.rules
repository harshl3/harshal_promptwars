rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Decisions collection: Strict user-level access control
    match /decisions/{decisionId} {
      // Allow read/delete only if authenticated user is document owner
      allow read, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Allow create only if authenticated and setting own userId
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.input != null
        && request.resource.data.analysis != null;
        
      // Allow update only if authenticated and keeping own userId
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
